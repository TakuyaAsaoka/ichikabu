# このファイルを .env.local にコピーして使う（.env.local はコミットしない）。
# 開発用DBは `docker compose up -d` で起動する。

DATABASE_URL=postgres://postgres:postgres@localhost:5434/ichikabu
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/ichikabu_test

# `openssl rand -base64 32` で生成する
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# 管理UIの「Google でログイン」。取得の手順は docs/guides/google-oauth.md。
# 未設定だとサーバーが起動時に落ちる
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# seed スクリプトが作る入力者（設計書 §9。画面からは作れない）。
# JSON の配列で書く。パスワードにどんな文字が入っても壊れないようにするため。
# **値はシングルクォートで囲む。** 囲まないと、パスワードに `#` が入っていたとき
# そこから後ろが落ちる（`--env-file` がコメントとして切るため）。
# 中にシングルクォートは入れないこと。囲みが途中で閉じる。
# 1人目が開発用データの保有を持つ（カレンダーの動作確認に使う）。
# Google でログインするときは、ここに書いたメールアドレスと同じ Google
# アカウントを使う。違うアドレスは、DBに利用者が無いので入れない
SEED_USERS='[{"email":"","password":""}]'

# 削除できる管理者のメールアドレス（設計書 §9）。1人だけ。
# SEED_USERS に書いたメールアドレスのどれかと同じにする。違う値を入れると
# 管理者が誰も居なくなり、銘柄・テーマ・テーマ所属・イベントを誰も消せなくなる。
# 未設定だとサーバーが起動時に落ちる（気づかないまま全員が消せない状態にしないため）。
# 大文字小文字は問わない
ADMIN_EMAIL=

# ---
# 配信先（Netlify + Supabase）の値はこのファイルには入れない。
# 別ファイル `.env.deploy.local` に置き、マイグレーションと利用者投入のときだけ
# シェルに読み込ませる。中身と手順は docs/guides/deploy.md を参照。
