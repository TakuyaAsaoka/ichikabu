{
  "name": "ichikabu-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "gen": "openapi-typescript ../openapi.yaml -o src/generated/api.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "auth:gen": "better-auth generate --config src/auth.ts --output src/db/auth-schema.ts",
    "build": "next build",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
